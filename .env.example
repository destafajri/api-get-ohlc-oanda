# Copy this file to .env and replace the placeholders. Never commit .env.
OANDA_TOKEN=replace-with-your-oanda-api-token
# Required by GET /instruments. Keep this server-side; it is never returned.
OANDA_ACCOUNT_ID=replace-with-your-oanda-account-id
OANDA_ENVIRONMENT=practice
OANDA_TIMEOUT_SECONDS=10

# Dedicated key for GET /ohlc/history. Clients send it as the `key` query parameter.
HISTORICAL_API_KEY=replace-with-a-long-random-token
# Delay between full historical OANDA chunks. Default is 5 seconds.
HISTORICAL_CHUNK_DELAY_SECONDS=5
# Candles requested per OANDA historical page. Default 2500; OANDA max 5000.
HISTORICAL_PAGE_SIZE=2500

# Optional dedicated secret for GET /research/oanda-context.
# Set this only when you need the redacted OANDA country context for research.
RESEARCH_CONTEXT_TOKEN=replace-with-a-long-random-token

# Optional static Bearer access for CLI/IDE MCP clients such as Codex or Claude Code.
# Required only when OAuth is not configured.
MCP_AUTH_TOKEN=replace-with-a-long-random-token

# OAuth 2.1 resource-server mode. Configure all three together.
# MCP_PUBLIC_URL must exactly match the deployed MCP endpoint and the
# authorization server's Resource Indicator / token audience.
MCP_PUBLIC_URL=https://api.example.com/mcp/
MCP_OAUTH_ISSUER_URL=https://your-project.authkit.app
MCP_OAUTH_JWKS_URL=https://your-project.authkit.app/oauth2/jwks

# Optional comma-separated overrides for custom deployment hosts/origins.
# Vercel deployment hosts are discovered automatically from VERCEL_* variables.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
